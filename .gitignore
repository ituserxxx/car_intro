# ==============================================
# 通用忽略（所有项目都不需要提交的文件）
# ==============================================
.DS_Store          # Mac 系统文件
shturl.cc          # Windows 缩略图
.idea/             # JetBrains IDE（GoLand/IDEA等）
.vscode/           # VS Code 配置（可选保留，按需删除）
*.log              # 日志文件
*.tmp              # 临时文件
*.swp              # Vim 临时文件
.env               # 环境变量（核心！绝对不能提交）
.shturl.cc
.env.*.local

# ==============================================
# Python 项目忽略
# ==============================================
__pycache__/       # 缓存文件夹
*.py[cod]          # 编译后的文件
*.so
.Python
env/               # 虚拟环境
venv/
.venv/
pip-wheel-metadata/
dist/
build/
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.tox/
.coverage

# ==============================================
# Vue / 前端项目忽略
# ==============================================
node_modules/      # 依赖包（最大的文件夹，必须忽略）
dist/              # 打包产物
build/
*.local
.output/
.nuxt/
.vuepress/dist
.cache/
.temp/

# ==============================================
# Rust 项目忽略
# ==============================================
*/target/           # 编译产物（必须忽略）
shturl.cc/         # 【可选】库项目不提交，二进制项目可提交，按需保留