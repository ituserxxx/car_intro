# ==============================================
# 通用忽略（所有项目都不需要提交的文件）
# ==============================================
.DS_Store          # Mac 系统文件
Thumbs.db          # Windows 缩略图
desktop.ini        # Windows 系统文件
.idea/             # JetBrains IDE（GoLand/IDEA等）
.vscode/           # VS Code 配置（可选保留，按需删除）
*.log              # 日志文件
*.tmp              # 临时文件
*.swp              # Vim 临时文件
.env               # 环境变量（核心！绝对不能提交）
.env.*.local

# ==============================================
# Python 项目忽略
# ==============================================
__pycache__/       # 缓存文件夹
*.py[cod]          # 编译后的文件
*.so
.Python
env/               # 虚拟环境
venv/
.venv/
pip-wheel-metadata/
dist/
build/
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.tox/
.coverage
.mypy_cache/
.ruff_cache/

# ==============================================
# Vue / 前端项目忽略
# ==============================================
*/node_modules/      # 依赖包（最大的文件夹，必须忽略）
*/dist/              # 打包产物
*/build/
*.local
.output/
.nuxt/
.vuepress/dist
.cache/
.temp/
.eslintcache
.stylelintcache
yarn-error.log

# ==============================================
# Rust 项目忽略
# ==============================================
*/target/           # 编译产物（必须忽略）
# Cargo.lock       # 二进制项目建议提交，库项目可忽略。当前 web_rust 是二进制项目，故保留
*/car_pdfs/